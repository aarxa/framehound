; framehound's Godot test scene: a small game-like 3D scene for trying the Vulkan layer on a real engine.
; See main.gd and native/README.md.

config_version=5

[application]

config/name="framehound test scene"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false

[display]

window/size/viewport_width=768
window/size/viewport_height=432
window/size/resizable=false
window/dpi/allow_hidpi=false
window/vsync/vsync_mode=0

[rendering]

rendering_device/driver.macos="vulkan"
